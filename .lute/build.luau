local FlipbookBatteries = require("@luaupkg/FlipbookBatteries@v0.10.1")
local cli = require("@batteries/cli")
local fs = require("@std/fs")

local project = require("@repo/project")

local find = FlipbookBatteries.find
local mkdir = FlipbookBatteries.mkdir
local rmdir = FlipbookBatteries.rmdir
local run = FlipbookBatteries.run

local args = cli.parser()

args:add("channel", "option", {
	help = "channel to build for",
	aliases = { "c" },
	default = "prod",
})

args:parse({ ... })

local channel = args:get("channel")
assert(channel == "dev" or channel == "prod", `bad value for channel (must be one of "dev" or "prod", got "{channel}")`)

local PRUNED_FILE_PATTERNS = {
	"%.spec%.luau",
	"jest%.config%.luau",
	"examples",
}

local function build()
	if fs.exists(project.BUILD_PATH) and fs.type(project.BUILD_PATH) == "dir" then
		rmdir(project.BUILD_PATH)
	end
	mkdir(project.BUILD_PATH)

	run("rojo", {
		"sourcemap",
		project.ROJO_BUILD_PROJECT,
		"-o",
		project.DARKLUA_SOURCEMAP_PATH,
	})

	for _, pkg in project.PACKAGES do
		run("darklua", {
			"process",
			pkg.sourcePath,
			pkg.buildPath,
		})
	end

	-- The package root module. Generated (not darklua-processed) because it
	-- must use Roblox-style requires relative to the published mount, where
	-- dist/ is the package root and Wally's dependency links live one level
	-- above it.
	fs.writeStringToFile(
		`{project.BUILD_PATH}/init.luau`,
		table.concat({
			"--!strict",
			"-- Generated by .lute/build.luau — do not edit.",
			"local ReactTesting = require(script.ReactTesting)",
			"",
			"export type TextMatch = ReactTesting.TextMatch",
			"export type TextMatchOptions = ReactTesting.TextMatchOptions",
			"export type BoundQueries = ReactTesting.BoundQueries",
			"export type RenderOptions = ReactTesting.RenderOptions",
			"export type RenderResult = ReactTesting.RenderResult",
			"export type WaitForOptions = ReactTesting.WaitForOptions",
			"",
			"return ReactTesting",
			"",
		}, "\n")
	)

	if channel == "prod" then
		for _, prunedFilePattern in PRUNED_FILE_PATTERNS do
			local prunedFiles = find(project.BUILD_PATH, prunedFilePattern)
			for _, prunedPath in prunedFiles do
				if fs.type(prunedPath) == "dir" then
					rmdir(prunedPath)
				else
					fs.remove(prunedPath)
				end
			end
		end
	end
end

build()
